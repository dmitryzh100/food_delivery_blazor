<div class="search">
    <svg class="search__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" />
    </svg>

    <input class="search__input"
           type="search"
           inputmode="search"
           placeholder="Find for food or restaurant..."
           aria-label="Find for food or restaurant"
           value="@_value"
           @oninput="OnInput" />
</div>

@implements IDisposable

@code {
    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public int DebounceDelay { get; set; } = 400;

    private string _value = string.Empty;
    private string _lastEmitted = string.Empty;
    private CancellationTokenSource? _debounceCts;

    protected override void OnParametersSet()
    {
        if (Value != _lastEmitted)
        {
            _value = Value;
            _lastEmitted = Value;
        }
    }

    private async Task OnInput(ChangeEventArgs args)
    {
        _value = args.Value?.ToString() ?? string.Empty;

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();

        CancellationToken token = _debounceCts.Token;

        try
        {
            await Task.Delay(DebounceDelay, token);

            _lastEmitted = _value;

            await ValueChanged.InvokeAsync(_value);
        }
        catch (TaskCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
