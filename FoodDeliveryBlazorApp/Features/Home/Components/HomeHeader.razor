@inject IStringLocalizer<SharedResource> Localizer

<header class="header">
    <button type="button" class="header__icon-btn" @onclick="OnMenuClick" aria-label="@Localizer["HomeHeaderOpenMenuAria"]">
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
            <line x1="4" y1="8" x2="20" y2="8" />
            <line x1="4" y1="16" x2="13" y2="16" />
        </svg>
    </button>

    <div class="delivery">
        <button type="button"
                class="delivery__toggle"
                @onclick="ToggleDropdown"
                aria-haspopup="listbox"
                aria-expanded="@(_isOpen ? "true" : "false")">
            <span class="delivery__caption">
                @Localizer["HomeHeaderDeliverTo"]
                <svg class="delivery__caret @(_isOpen ? "delivery__caret--open" : null)" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <polyline points="6 9 12 15 18 9" />
                </svg>
            </span>
            <span class="delivery__address">@SelectedAddress?.FullAddress</span>
        </button>

        @if (_isOpen)
        {
            <button type="button" class="delivery__backdrop" aria-label="@Localizer["HomeHeaderCloseAddressAria"]" @onclick="Close"></button>
            <ul class="delivery__menu" role="listbox" aria-label="@Localizer["HomeHeaderDeliveryAddressAria"]">
                @foreach (DeliveryAddress address in Addresses)
                {
                    <li role="option" aria-selected="@(address == SelectedAddress ? "true" : "false")">
                        <button type="button"
                                class="delivery__option @(address == SelectedAddress ? "delivery__option--active" : null)"
                                @onclick="() => SelectAsync(address)">
                            <span class="delivery__option-label">@address.Tag</span>
                            <span class="delivery__option-line">@address.FullAddress</span>
                        </button>
                    </li>
                }
            </ul>
        }
    </div>

    <button type="button" class="header__profile" @onclick="OnProfileClick" aria-label="@Localizer["HomeHeaderOpenAccountAria"]">
        <UserAvatar Size="38" Shape="AvatarShape.Rounded" Src="@AvatarSrc" />
    </button>
</header>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<DeliveryAddress> Addresses { get; set; } = [];

    [Parameter, EditorRequired]
    public DeliveryAddress? SelectedAddress { get; set; }

    [Parameter]
    public string AvatarSrc { get; set; } = "images/avatar.png";

    [Parameter]
    public EventCallback OnMenuClick { get; set; }

    [Parameter]
    public EventCallback OnProfileClick { get; set; }

    [Parameter]
    public EventCallback<DeliveryAddress> OnAddressSelected { get; set; }

    private bool _isOpen;

    private void ToggleDropdown()
    {
        _isOpen = !_isOpen;
    }

    private void Close()
    {
        _isOpen = false;
    }

    private async Task SelectAsync(DeliveryAddress address)
    {
        _isOpen = false;

        await OnAddressSelected.InvokeAsync(address);
    }
}
