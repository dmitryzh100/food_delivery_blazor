@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<div class="side-menu @(Open ? "side-menu--open" : null)">
    <button type="button" class="side-menu__scrim" aria-label="@Localizer["SideMenuCloseAria"]" tabindex="@(Open ? 0 : -1)" @onclick="OnClose"></button>

    <aside class="side-menu__panel" aria-label="@Localizer["SideMenuAccountAria"]" aria-hidden="@(Open ? "false" : "true")">
        <div class="side-menu__lang">
            <ThemeToggle />
            <LanguageSelector />
        </div>

        <div class="side-menu__profile">
            <UserAvatar Size="90" Shape="AvatarShape.Circle" Src="@AvatarSrc" />
            <h2 class="side-menu__name">@UserName</h2>
            <p class="side-menu__email">@UserEmail</p>
        </div>

        <nav class="side-menu__nav" aria-label="@Localizer["SideMenuNavAria"]">
            @foreach (MenuItem item in _items)
            {
                <button type="button" class="side-menu__item" tabindex="@(Open ? 0 : -1)" @onclick="() => NavigateTo(item)">
                    <span class="side-menu__item-icon">
                        <img src="@item.IconSrc" alt="" />
                    </span>
                    <span class="side-menu__item-label">@Localizer[item.Label]</span>
                </button>
            }
        </nav>

        <button type="button" class="side-menu__logout" @onclick="OnLogout" tabindex="@(Open ? 0 : -1)">
            <MudIcon Icon="@Icons.Material.Outlined.PowerSettingsNew" Size="Size.Small" Color="Color.Inherit" />
            <span>@Localizer["SideMenuLogOut"]</span>
        </button>
    </aside>
</div>

@code {
    [Parameter, EditorRequired]
    public bool Open { get; set; }

    [Parameter, EditorRequired]
    public string UserName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string UserEmail { get; set; } = string.Empty;

    [Parameter]
    public string AvatarSrc { get; set; } = "images/avatar.png";

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnLogout { get; set; }

    private readonly IReadOnlyList<MenuItem> _items =
    [
        new MenuItem("SideMenuMyOrders", "images/menu/icon_my_orders.svg"),
        new MenuItem("SideMenuMyProfile", "images/menu/icon_profile.png", AppRoutes.Profile),
        new MenuItem("SideMenuDeliveryAddress", "images/menu/icon_location.svg", AppRoutes.Addresses),
        new MenuItem("SideMenuPaymentMethods", "images/menu/icon_wallet.svg"),
        new MenuItem("SideMenuContactUs", "images/menu/icon_envelope.svg"),
        new MenuItem("SideMenuSettings", "images/menu/icon_gear.svg"),
        new MenuItem("SideMenuHelpsFaqs", "images/menu/icon_question.svg"),
    ];

    private async Task NavigateTo(MenuItem item)
    {
        if (string.IsNullOrEmpty(item.Route))
        {
            return;
        }

        await OnClose.InvokeAsync();

        Navigation.NavigateTo(item.Route);
    }
}
