@inject IStringLocalizer<SharedResource> Localizer

<section class="featured">
    <header class="featured__head">
        <h2 class="featured__title">@Localizer["FeaturedTitle"]</h2>
        <a class="featured__all" href="#">@Localizer["FeaturedViewAll"] &rsaquo;</a>
    </header>

    <Slider>
        @foreach (Restaurant restaurant in Restaurants)
        {
            <RestaurantCard @key="restaurant" Restaurant="restaurant" />
        }
    </Slider>

    @if (Restaurants.Count == 0)
    {
        <p class="featured__empty">@Localizer["FeaturedEmpty"]</p>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Restaurant> Restaurants { get; set; } = [];
}
