@attribute [Route(AppRoutes.SignUp)]
@layout AuthLayout
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["SignUpTitle"]</PageTitle>

<section class="auth-page" aria-labelledby="signup-heading">
    <div class="auth-decor" aria-hidden="true">
        <span class="ellipse ellipse-ring"></span>
        <span class="ellipse ellipse-peach"></span>
        <span class="ellipse ellipse-orange"></span>
    </div>

    <h1 id="signup-heading" class="auth-title">@Localizer["SignUpTitle"]</h1>

    <EditForm EditContext="_editContext" OnValidSubmit="HandleSignUpAsync">
        <DataAnnotationsValidator />

        <div class="field">
            <label class="field-label" for="signup-name">@Localizer["CommonFullName"]</label>
            <InputText id="signup-name"
                       class="form-input"
                       @bind-Value="_model.FullName"
                       placeholder="@Localizer["SignUpFullNamePlaceholder"]"
                       autocomplete="name"
                       aria-describedby="signup-name-error"
                       aria-invalid="@AriaInvalid(() => _model.FullName)" />
            <div class="validation-region" id="signup-name-error" aria-live="polite">
                <ValidationMessage For="@(() => _model.FullName)" />
            </div>
        </div>

        <div class="field">
            <label class="field-label" for="signup-email">@Localizer["CommonEmail"]</label>
            <InputText id="signup-email"
                       class="form-input"
                       @bind-Value="_model.Email"
                       placeholder="@Localizer["SignUpEmailPlaceholder"]"
                       autocomplete="email"
                       inputmode="email"
                       aria-describedby="signup-email-error"
                       aria-invalid="@AriaInvalid(() => _model.Email)" />
            <div class="validation-region" id="signup-email-error" aria-live="polite">
                <ValidationMessage For="@(() => _model.Email)" />
            </div>
        </div>

        <div class="field">
            <label class="field-label" for="signup-password">@Localizer["CommonPassword"]</label>
            <PasswordField Id="signup-password"
                           @bind-Value="_model.Password"
                           Placeholder="@Localizer["CommonPassword"]"
                           Autocomplete="new-password"
                           AriaDescribedBy="signup-password-error"
                           AriaInvalid="@AriaInvalid(() => _model.Password)" />
            <div class="validation-region" id="signup-password-error" aria-live="polite">
                <ValidationMessage For="@(() => _model.Password)" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="auth-error" role="alert">@_error</p>
        }

        <button type="submit" class="btn-primary signup-submit" disabled="@_isBusy">
            @(_isBusy ? Localizer["SignUpSubmitting"] : Localizer["SignUpSubmit"])
        </button>
    </EditForm>

    <p class="auth-switch">@Localizer["SignUpHaveAccount"] <a class="link" href="@AppRoutes.Login">@Localizer["SignUpLoginLink"]</a></p>

    <SocialAuthButtons DividerText="@Localizer["SocialSignUpWith"]" />
</section>

@code {
    private readonly SignUpModel _model = new();
    private EditContext _editContext = default!;
    private bool _isBusy;
    private string? _error;

    protected override void OnInitialized()
    {
        _editContext = new EditContext(_model);
    }

    private async Task HandleSignUpAsync()
    {
        _isBusy = true;
        _error = null;

        AuthResult result = await AuthService.SignUpAsync(_model);

        _isBusy = false;

        if (result.Succeeded)
        {
            Navigation.NavigateTo(AppRoutes.Home);

            return;
        }

        _error = result.Error;
    }

    private string AriaInvalid<T>(Expression<Func<T>> field)
    {
        return _editContext.GetValidationMessages(FieldIdentifier.Create(field)).Any() ? "true" : "false";
    }
}
