@attribute [Route(AppRoutes.Welcome)]
@layout AuthLayout
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>@Localizer["WelcomePageTitle"]</PageTitle>

<section class="welcome" aria-labelledby="welcome-heading">
    <a class="welcome-skip" href="@AppRoutes.Login" aria-label="@Localizer["WelcomeSkipAria"]">@Localizer["WelcomeSkip"]</a>

    <header class="welcome-heading">
        <h1 id="welcome-heading" class="welcome-title">@Localizer["WelcomeTitle"] <span class="brand">FoodHub</span></h1>
        <p class="welcome-subtitle">@Localizer["WelcomeSubtitle"]</p>
    </header>

    <div class="welcome-bottom">
        <SocialAuthButtons DividerText="@Localizer["WelcomeSignInWith"]" />

        <a class="btn-outline welcome-start" href="@AppRoutes.Onboarding">@Localizer["WelcomeStart"]</a>

        <p class="auth-switch">@Localizer["WelcomeHaveAccount"] <a class="link" href="@AppRoutes.Login">@Localizer["WelcomeSignInLink"]</a></p>
    </div>
</section>

@code {
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState state = await AuthStateProvider.GetAuthenticationStateAsync();

        if (state.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(AppRoutes.Home);
        }
    }
}
